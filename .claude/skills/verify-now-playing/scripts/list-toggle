#!/bin/sh
PY=/usr/bin/python3; [ -x "$PY" ] || { PY=python3; python3 -c "" >/dev/null 2>&1 || PY=python; }
ov() { herdr-app status | "$PY" -c 'import json,sys; print(len([o for o in json.load(sys.stdin).get("overlays") or [] if o == "now-playing"]))'; }
press() { herdr-app do now-playing.sessions >/dev/null; /bin/sleep 0.6; }
expect() { got=$(ov); [ "$got" = "$1" ] && echo "ok    $2 ($got open)" || { echo "FAIL  $2: want $1, got $got"; fail=1; }; }
fail=0
herdr-app do overlay.close >/dev/null 2>&1; /bin/sleep 0.3
expect 0 "start closed"
press; expect 1 "first press opens"
press; expect 0 "second press closes"
press; expect 1 "third press opens again"
herdr-app do overlay.close >/dev/null; /bin/sleep 0.6; expect 0 "closed from outside (as Esc)"
press; expect 1 "one press reopens after an outside close"
for i in 1 2 3 4 5; do herdr-app do now-playing.sessions >/dev/null; /bin/sleep 0.15; done; /bin/sleep 0.6
expect 0 "six presses in a row end closed, never stacked"
exit $fail
