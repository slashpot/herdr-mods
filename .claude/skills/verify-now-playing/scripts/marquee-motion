#!/bin/sh
# marquee-motion [frames] [out-dir]: takes window shots back to back, crops the
# subtitle line of the Now Playing block, and prints how far the text moved
# between shots. Assumes the block sits bottom-left with the default 69px footer
# under it on a 2x display; adjust CROP otherwise.
set -eu
n="${1:-170}"; out="${2:-$(mktemp -d)}"
CROP="${CROP:-crop=340:36:134:2306,format=gray}"
mkdir -p "$out"; : > "$out/times.txt"
i=0
while [ "$i" -lt "$n" ]; do
  /usr/bin/python3 -c 'import time;print("%.3f"%time.time())' | sed "s/^/$i /" >> "$out/times.txt"
  herdr-app shot "$out/f$i.png" >/dev/null
  ffmpeg -v error -y -i "$out/f$i.png" -vf "$CROP" -f rawvideo "$out/f$i.raw"
  i=$((i + 1))
done
/usr/bin/python3 - "$out" <<'PY'
import sys
d = sys.argv[1]; W, H = 340, 36
ts = [float(l.split()[1]) for l in open(f"{d}/times.txt")]
fr = [open(f"{d}/f{i}.raw", "rb").read() for i in range(len(ts))]
def shift(a, b, maxs=60):
    best = None
    for s in range(-maxs, maxs + 1):
        err = n = 0
        for y in range(0, H, 2):
            r = y * W
            for x in range(max(0, -s) + 4, min(W, W - s) - 4, 2):
                err += abs(a[r + x] - b[r + x + s]); n += 1
        if best is None or err / n < best[0]: best = (err / n, s)
    return best[1]
pos = 0
print("t(s)  dt(ms)  step(px)  pos(px)")
for i in range(1, len(fr)):
    s = shift(fr[i - 1], fr[i]); pos += s
    print("%5.2f %6d %6d %7d" % (ts[i] - ts[0], (ts[i] - ts[i - 1]) * 1000, s, pos))
PY
