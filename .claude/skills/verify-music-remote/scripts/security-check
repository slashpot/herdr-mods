#!/bin/sh
# Checks the Music Remote mod for the security properties in features/security.md.
# Read-only for the repo and the person's window; scratch files go to a temp dir.
# Run from the repo root. Exit 0 when every check passes.
set -u
mod=music-remote/mods/music-remote
fail=0
ok() { echo "ok    $1"; }
bad() { echo "FAIL  $1"; fail=1; }

[ -f "$mod/main.js" ] || { echo "run from the herdr-mods repo root" >&2; exit 2; }

relative=$(grep -nE 'exec\("[^/]' "$mod/native/macos/backend.js")
[ -z "$relative" ] && ok "macOS exec calls use absolute paths" || bad "macOS exec runs a program from PATH: $relative"

grep -q 'exec(\$' "$mod"/native/*/backend.js "$mod/main.js" && bad "exec takes a computed program name" || ok "exec program names are literals"

script=$(grep -n 'osascript' "$mod/native/macos/backend.js" | cut -d: -f1)
guard=$(sed -n "$((script - 1))p" "$mod/native/macos/backend.js")
case "$guard" in
  *'SCRIPTED.has(bundle)'*) ok "AppleScript runs only for bundles in SCRIPTED" ;;
  *) bad "the osascript call is not directly under if (SCRIPTED.has(bundle)): $guard" ;;
esac

grep -nE '\bfetch\(|\bhc\(' "$mod/main.js" "$mod"/native/*/backend.js && bad "the mod talks to the network or herdr-core" || ok "no fetch or hc calls"

tracked=$(git ls-files "$mod" | grep -E '/bin/|\.dylib$|\.exe$|\.dll$')
[ -z "$tracked" ] && ok "no binaries tracked in git" || bad "binaries tracked: $tracked"

grep -q 'SafeName \$session.SourceAppUserModelId' "$mod/native/windows/nowplaying.ps1" \
  && ok "Windows artwork name goes through SafeName" || bad "Windows artwork name skips SafeName"

grep -q '"-File"' "$mod/native/windows/backend.js" && ! grep -q '"-Command"' "$mod/native/windows/backend.js" \
  && ok "PowerShell runs the helper with -File, not -Command" || bad "PowerShell is not called with -File only"

outside=
for line in $(grep -nE -- '--delete|-delete' music-remote/install.sh | cut -d: -f1); do
  sed -n "${line}p" music-remote/install.sh | grep -q '"\$dest' || outside="$outside $line"
done
[ -z "$outside" ] && ok "install.sh deletes only inside \$dest" || bad "install.sh deletes outside \$dest on line(s)$outside"

if [ "$(uname -s)" = Darwin ] && command -v clang >/dev/null 2>&1; then
  tmp=$(mktemp -d)
  mkdir "$tmp/a" "$tmp/a/b" "$tmp/a/b/art"
  cat > "$tmp/harness.m" <<EOF
#include "$PWD/$mod/native/macos/nowplaying.m"
int main(void) { @autoreleasepool {
  setenv("NP_ART_DIR", "$tmp/a/b/art", 1);
  NSData *d = [@"x" dataUsingEncoding:NSUTF8StringEncoding];
  for (NSString *b in @[@"../../evil", @"a/b", @"com.some-app"]) printf("%s\n", saveArtwork(b, d, @"image/jpeg").UTF8String);
  pruneArtwork(@[@{@"bundle": @"../../evil"}]);
} }
EOF
  if clang -fobjc-arc -framework Foundation -framework AppKit "$tmp/harness.m" -o "$tmp/harness" 2>"$tmp/cc.log"; then
    "$tmp/harness" >/dev/null
    escaped=$(find "$tmp" -name '*evil*' -not -path "$tmp/a/b/art/*")
    [ -z "$escaped" ] && ok "macOS artwork stays in its folder for bundle ../../evil" || bad "artwork escaped: $escaped"
    [ -e "$tmp/a/b/art/.._.._evil-11f6ad8ec52a2984.jpg" ] \
      && ok "prune keeps the art of a session still waiting, by its cleaned name" || bad "prune removed a waiting session's art"
    [ ! -e "$tmp/a/b/art/a_b-11f6ad8ec52a2984.jpg" ] && ok "prune removes art no session shows" || bad "prune kept unused art"
  else
    bad "nowplaying.m harness did not compile: $(head -3 "$tmp/cc.log")"
  fi
  rm -rf "$tmp"
else
  echo "skip  macOS artwork harness (needs macOS and clang)"
fi

exit "$fail"
